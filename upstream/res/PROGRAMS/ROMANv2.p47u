@ Index:   Roman numerals conversion
@ Author:  arkanda
@ Version: 2
@ Source:  https://forum.swissmicros.com/viewtopic.php?f=48&t=5003
@ Tested:  jaymos, added comments
@ input:   integer or a roman numeral into the x register
@ output:  integer or a roman numeral into the x and y registers
@
LBL ‘ROMANv2’
  STRING?
    GTO 03
  STO R20
  STO R23
  42CLA
  1000.77                  ; M = 1000
  XEQ 00
  900.6777                 ; CM = 900
  XEQ 00
  500.68                   ; D = 500
  XEQ 00
  400.6768                 ; CD = 400
  XEQ 00
  100.67                   ; C = 100
  XEQ 00
  90.8867                  ; XC = 90
  XEQ 00
  50.76                    ; L = 50
  XEQ 00
  40.8876                  ; XL = 40
  XEQ 00
  10.88                    ; X = 10
  XEQ 00
  9.7388                   ; IX = 9
  XEQ 00
  5.86                     ; V = 5
  XEQ 00
  4.7386                   ; IV = 4
  XEQ 00
  1.73                     ; I = 1
  XEQ 00
  CLSTK
  RCL R23
  RCL K
  RTN

LBL 00                     ; Integer to Roman numeral conversion for one entry
  ENTER
  IP                       ; Integer part encodes the value
  STO R21
  𝑥⇄𝑦
  FP                       ; Fractional part encodes the character codes
  STO R22

  LBL 01
    RCL R20
    RCL R21
    𝑥>? Y
      RTN                  ; Stop when the remaining integer is too small
    STO- R20               ; Subtract the current Roman numeral value
    RCL R22

    LBL 02
      100
      ×
      42XTOA               ; Append the next encoded character
      FP
      𝑥≠? 0.
        GTO 02             ; Extract further characters from the encoding
      GTO 01               ; Repeat while the value can still be subtracted
      STOP

      LBL 03               ; Roman numeral string to integer conversion
        STO R24
        STO K              ; Preserve the original input string
        0
        STO R20            ; Initialise the accumulated integer
        CL𝑥
        XEQ 10             ; Decode the first character

      LBL 04
        42ALENG
        𝑥=? 0.
          GTO 05           ; No characters remain
        RCL R22
        STO R21            ; Save the preceding character's value
        XEQ 10             ; Decode the next character
        RCL R22
        RCL R21
        𝑥<? Y
          CHS              ; A smaller preceding value must be subtracted
        STO+ R20           ; Accumulate the signed character value
        GTO 04

      LBL 05
        RCL R22
        STO+ R20           ; Add the final character value
        CLSTK
        RCL R24
        RCL R20
        RTN

      LBL 10               ; Decode a Roman numeral character
        42ATOX
        →REAL
        STO R23            ; Preserve the character code for matching
        0
        STO R22            ; Initialise the decoded value
        1000.77            ; M = 1000
        XEQ 11
        500.68             ; D = 500
        XEQ 11
        100.67             ; C = 100
        XEQ 11
        50.76              ; L = 50
        XEQ 11
        10.88              ; X = 10
        XEQ 11
        5.86               ; V = 5
        XEQ 11
        1.73               ; I = 1
        XEQ 11
        RTN

      LBL 11               ; Match the character code to its Roman value
        ENTER
        IP
        𝑥⇄𝑦
        FP
        100
        ×
        RCL R23
        𝑥≠? Y
          RTN              ; No match, retain the initial or previous value
        R↓
        R↓
        STO R22            ; Store the matched Roman numeral value
        RTN
.END.