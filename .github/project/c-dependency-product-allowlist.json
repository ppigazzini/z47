{
  "description": "Phase H product-lane C dependency audit policy",
  "scan_globs": [
    "build.zig",
    "zig_build/**/*.zig"
  ],
  "allowed_external_prefixes": [
    "dep/decNumberICU/",
    "decNumberICU/",
    "dep/DMCP_SDK/",
    "dep/DMCP5_SDK/",
    "dep/forcecrc32.c"
  ],
  "first_party_prefixes": [
    "src/",
    "zig_bridge/"
  ],
  "generated_prefixes": [
    "generated/",
    "zig_build/generated/"
  ],
  "ignored_prefixes": [
    "src/generateCatalogs/",
    "src/generateConstants/",
    "src/generateTestPgms/",
    "src/generated/",
    "src/testSuite/",
    "src/ttf2RasterFonts/",
    "zig_build/tests/",
    "zig_bridge/mathematics/math_wrappers_runtime_helpers.c",
    "zig_bridge/mathematics/random_runtime_helpers.c",
    "zig_bridge/state/register_metadata_runtime_helpers.c",
    "zig_bridge/state/registers_retained.c",
    "zig_bridge/state/stack_runtime_helpers.c"
  ],
  "baseline_file": ".github/project/c-dependency-product-first-party-baseline.txt"
}
